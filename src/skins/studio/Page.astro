---
/**
 * SKIN: Studio  ·  archetype: Horizontal Agency  ·  motion: GSAP + ScrollTrigger
 *
 * The Webflow award look. Paper cream, hard ink, one hot orange, oversized
 * Bricolage display type set tight, hairline rules instead of cards.
 *
 * Layout engine: PINNED HORIZONTAL TRACK. The features section pins to the
 * viewport and scrolls sideways. Nothing else in the library scrolls sideways.
 * The pin is disabled below 861px, where the rail becomes a stacked grid.
 */
import { content as c } from '../../lib/content';

const year = 2026;
const headWords = [...c.hero.headline.split(' '), ...c.hero.headlineAccent.split(' ')];
const marquee = [...c.logos.items, ...c.logos.items, ...c.logos.items];
---

<div class="stu">
  <div class="stu-cursor" data-cursor aria-hidden="true"><span></span></div>

  <header class="stu-nav">
    <div class="stu-wrap stu-nav__in">
      <a class="stu-brand" href="#">
        <span class="stu-brand__mark">{c.brand.mark}</span>
        <span>{c.brand.name}</span>
      </a>
      <nav class="stu-nav__links" aria-label="Primary">
        {c.nav.links.map((l, i) => (
          <a href={l.href}>
            <em>{String(i + 1).padStart(2, '0')}</em>
            {l.label}
          </a>
        ))}
      </nav>
      <a class="stu-btn stu-btn--sm" href={c.nav.cta.href}>{c.nav.cta.label}</a>
    </div>
  </header>

  <section class="stu-hero">
    <div class="stu-wrap">
      <div class="stu-hero__meta" data-anim>
        <span class="stu-dot"></span>
        <span>{c.hero.eyebrow}</span>
        <span class="stu-hero__year">{year}</span>
      </div>

      <h1 class="stu-h1" aria-label={`${c.hero.headline} ${c.hero.headlineAccent}`}>
        {
          headWords.map((w, i) => (
            <span class:list={['stu-word', { 'stu-word--acc': i >= c.hero.headline.split(' ').length }]} data-anim>
              <span>{w}</span>
            </span>
          ))
        }
      </h1>

      <div class="stu-hero__row">
        <p class="stu-hero__sub" data-anim>{c.hero.sub}</p>
        <div class="stu-hero__act" data-anim>
          <a class="stu-btn" href={c.hero.ctaPrimary.href}>
            {c.hero.ctaPrimary.label}
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 13 13 3M6 3h7v7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="stu-link" href={c.hero.ctaSecondary.href}>{c.hero.ctaSecondary.label}</a>
          <p class="stu-hero__note">{c.hero.note}</p>
        </div>
      </div>
    </div>

    <div class="stu-marq" aria-label={c.logos.label}>
      <div class="stu-marq__track">
        {
          marquee.map((n) => (
            <span class="stu-marq__item">
              {n}
              <i>&#9679;</i>
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <section class="stu-sec stu-sec--rule">
    <div class="stu-wrap stu-two">
      <div class="stu-two__l">
        <p class="stu-eyebrow" data-anim>{c.problem.eyebrow}</p>
      </div>
      <div class="stu-two__r">
        <h2 class="stu-h2" data-anim>{c.problem.headline}</h2>
        <p class="stu-lead" data-anim>{c.problem.body}</p>
        <div class="stu-probs">
          {
            c.problem.points.map((p, i) => (
              <article class="stu-prob" data-anim>
                <span class="stu-prob__n">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- THE HORIZONTAL TRACK. The pinned element owns overflow: hidden so the
       rail is clipped by the viewport sized box it lives in, never by the page. -->
  <section class="stu-track" id="features">
    <div class="stu-track__pin" data-track-pin>
      <div class="stu-wrap stu-track__head">
        <div>
          <p class="stu-eyebrow" data-anim>{c.features.eyebrow}</p>
          <h2 class="stu-h2 stu-h2--sm" data-anim>{c.features.headline}</h2>
        </div>
        <p class="stu-track__hint" data-anim>
          <span>Keep scrolling</span>
          <svg width="34" height="10" viewBox="0 0 34 10" fill="none" aria-hidden="true">
            <path d="M0 5h31M27 1l5 4-5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </p>
      </div>

      <div class="stu-track__rail" data-track-rail>
        {
          c.features.items.map((f) => (
            <article class="stu-panel" data-anim>
              <span class="stu-panel__n">{f.glyph}</span>
              <h3 class="stu-panel__t">{f.title}</h3>
              <p class="stu-panel__b">{f.body}</p>
              <span class="stu-panel__rule"></span>
            </article>
          ))
        }
      </div>

      <div class="stu-wrap stu-track__foot">
        <span class="stu-track__bar"><i data-track-bar></i></span>
        <span class="stu-track__count">
          {c.features.items.length} surfaces
        </span>
      </div>
    </div>
  </section>

  <section class="stu-sec" id="showcase">
    <div class="stu-wrap stu-two">
      <div class="stu-two__l">
        <p class="stu-eyebrow" data-anim>{c.showcase.eyebrow}</p>
        <div class="stu-stack" data-anim>
          {
            ['Google Workspace', 'Slack', 'Stripe', 'Drive'].map((n, i) => (
              <span class="stu-stack__row" style={`--i:${i}`}>
                {n}
                <i>&rarr;</i>
              </span>
            ))
          }
          <span class="stu-stack__hub">{c.brand.name}</span>
        </div>
      </div>
      <div class="stu-two__r">
        <h2 class="stu-h2" data-anim>{c.showcase.headline}</h2>
        <p class="stu-lead" data-anim>{c.showcase.body}</p>
        <ul class="stu-checks">
          {
            c.showcase.bullets.map((b) => (
              <li data-anim>
                <em></em>
                {b}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="stu-stats">
    <div class="stu-wrap stu-stats__row">
      {
        c.stats.map((s) => (
          <div class="stu-stat" data-anim>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="stu-sec stu-sec--rule" id="proof">
    <div class="stu-wrap stu-two">
      <div class="stu-two__l">
        <p class="stu-eyebrow" data-anim>{c.proof.eyebrow}</p>
      </div>
      <div class="stu-two__r">
        <h2 class="stu-h2" data-anim>{c.proof.headline}</h2>
        <div class="stu-quotes">
          {
            c.testimonials.map((t) => (
              <figure class="stu-quote" data-anim>
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  <em>{t.role}, {t.company}</em>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="stu-sec" id="pricing">
    <div class="stu-wrap">
      <div class="stu-head">
        <p class="stu-eyebrow" data-anim>{c.pricing.eyebrow}</p>
        <h2 class="stu-h2" data-anim>{c.pricing.headline}</h2>
        <p class="stu-lead" data-anim>{c.pricing.sub}</p>
      </div>
      <div class="stu-plans">
        {
          c.pricing.plans.map((p) => (
            <article class:list={['stu-plan', { 'is-feat': p.featured }]} data-anim>
              <div class="stu-plan__top">
                <h3>{p.name}</h3>
                {p.featured && <span class="stu-plan__tag">Most teams</span>}
              </div>
              <p class="stu-plan__price">
                <strong>{p.price}</strong>
                <em>{p.period}</em>
              </p>
              <p class="stu-plan__blurb">{p.blurb}</p>
              <a class:list={['stu-btn', 'stu-btn--full', { 'stu-btn--out': !p.featured }]} href="#cta">
                {p.cta}
              </a>
              <ul class="stu-plan__feat">
                {p.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="stu-guar" data-anim>
        <h3>{c.guarantee.headline}</h3>
        <p>{c.guarantee.body}</p>
      </div>
    </div>
  </section>

  <section class="stu-sec stu-sec--rule">
    <div class="stu-wrap stu-two">
      <div class="stu-two__l">
        <p class="stu-eyebrow" data-anim>{c.faqHead.eyebrow}</p>
        <h2 class="stu-h2 stu-h2--sm" data-anim>{c.faqHead.headline}</h2>
      </div>
      <div class="stu-two__r">
        <div class="stu-faq" data-anim>
          {
            c.faq.map((f, i) => (
              <details class="stu-faq__item" open={i === 0}>
                <summary>
                  <span class="stu-faq__q">{f.q}</span>
                  <span class="stu-faq__ico" aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="stu-cta" id="cta">
    <div class="stu-wrap stu-cta__in">
      <h2 class="stu-cta__h" data-anim>{c.cta.headline}</h2>
      <p class="stu-cta__sub" data-anim>{c.cta.sub}</p>
      <a class="stu-btn stu-btn--lg" href={c.cta.button.href} data-anim>
        {c.cta.button.label}
        <svg width="17" height="17" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 13 13 3M6 3h7v7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <p class="stu-cta__note" data-anim>{c.cta.note}</p>
    </div>
  </section>

  <footer class="stu-foot">
    <div class="stu-wrap stu-foot__in">
      <div class="stu-foot__brand">
        <a class="stu-brand" href="#">
          <span class="stu-brand__mark">{c.brand.mark}</span>
          <span>{c.brand.name}</span>
        </a>
        <p>{c.brand.tagline}</p>
      </div>
      {
        c.footer.columns.map((col) => (
          <div class="stu-foot__col">
            <h4>{col.title}</h4>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="stu-wrap stu-foot__legal">
      <span>&copy; {year} {c.brand.name}</span>
      <span>{c.footer.legal}</span>
    </div>
  </footer>
</div>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector('.stu');
  if (root) {
    const q = (sel) => Array.from(root.querySelectorAll(sel));
    const anims = q('[data-anim]');
    const words = q('.stu-word > span');
    const panels = q('.stu-panel');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const embedded = document.documentElement.classList.contains('embed');

    if (reduced) {
      gsap.set(anims, { opacity: 1, y: 0 });
      gsap.set(words, { y: 0 });
    } else {
      const heroAnims = q('.stu-hero [data-anim]');
      const skip = new Set([...heroAnims, ...panels]);

      /* ---- hero ---- */
      gsap
        .timeline({ defaults: { ease: 'power3.out' } })
        .fromTo('.stu-hero__meta', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 })
        .to('.stu-word', { opacity: 1, duration: 0.01, stagger: 0.035 }, 0.1)
        .to('.stu-word > span', { y: '0%', duration: 1.15, stagger: 0.035, ease: 'expo.out' }, 0.1)
        .fromTo('.stu-hero__sub', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.75 }, 0.55)
        .fromTo('.stu-hero__act', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.75 }, 0.62);

      /* ---- below the fold. Tight cascade so the tail is never left at
             opacity 0 once the trigger has fired ---- */
      ScrollTrigger.batch(
        anims.filter((el) => !skip.has(el)),
        {
          start: 'top 90%',
          once: true,
          batchMax: 4,
          onEnter: (batch) =>
            gsap.fromTo(
              batch,
              { opacity: 0, y: 32 },
              { opacity: 1, y: 0, duration: 0.65, stagger: 0.05, ease: 'power3.out', overwrite: 'auto' }
            ),
        }
      );

      /* ---- track panels reveal together, before the pin takes over. A trigger
             per panel would never fire on desktop: once pinned the panels move
             sideways, and a vertical ScrollTrigger cannot see that ---- */
      if (panels.length) {
        ScrollTrigger.create({
          trigger: '.stu-track',
          start: 'top 82%',
          once: true,
          onEnter: () =>
            gsap.fromTo(
              panels,
              { opacity: 0, y: 40 },
              { opacity: 1, y: 0, duration: 0.6, stagger: 0.05, ease: 'power3.out' }
            ),
        });
      }

      /* ---- logo marquee. Track holds the list three times ---- */
      const track = root.querySelector('.stu-marq__track');
      if (track) gsap.to(track, { xPercent: -33.3333, duration: 26, ease: 'none', repeat: -1 });

      /* ---- THE HORIZONTAL PIN. Desktop only. Below 861px matchMedia reverts
             it and the rail falls back to the stacked grid the CSS declares ---- */
      const mm = gsap.matchMedia();
      mm.add('(min-width: 861px)', () => {
        const pin = root.querySelector('[data-track-pin]');
        const rail = root.querySelector('[data-track-rail]');
        const bar = root.querySelector('[data-track-bar]');
        if (!pin || !rail) return;

        const distance = () => Math.max(0, rail.scrollWidth - window.innerWidth);

        gsap.to(rail, {
          x: () => -distance(),
          ease: 'none',
          scrollTrigger: {
            trigger: pin,
            start: 'top top',
            end: () => '+=' + (distance() + window.innerHeight * 0.35),
            pin: true,
            scrub: 0.7,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              if (bar) gsap.set(bar, { scaleX: self.progress });
            },
          },
        });
      });

      /* ---- trailing cursor ring. Never on touch, never inside the gallery
             preview iframes. The native cursor stays visible on purpose ---- */
      if (!embedded && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const cur = root.querySelector('[data-cursor]');
        if (cur) {
          cur.classList.add('is-on');
          const xTo = gsap.quickTo(cur, 'x', { duration: 0.4, ease: 'power3' });
          const yTo = gsap.quickTo(cur, 'y', { duration: 0.4, ease: 'power3' });
          let shown = false;
          window.addEventListener('pointermove', (e) => {
            xTo(e.clientX);
            yTo(e.clientY);
            if (!shown) {
              shown = true;
              gsap.to(cur, { opacity: 1, duration: 0.3 });
            }
          });
          q('a, button, summary').forEach((el) => {
            el.addEventListener('pointerenter', () => gsap.to(cur, { scale: 2.1, opacity: 0.45, duration: 0.3 }));
            el.addEventListener('pointerleave', () => gsap.to(cur, { scale: 1, opacity: 1, duration: 0.3 }));
          });
        }
      }
    }

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => ScrollTrigger.refresh());
    }
  }
</script>

<style is:global>
  .stu {
    --paper: #f2f0eb;
    --paper-2: #e8e5dd;
    --ink: #0d0d0d;
    --ink-2: #45433e;
    --ink-3: #5f5c56;
    --line: rgba(13, 13, 13, 0.14);
    --line-2: rgba(13, 13, 13, 0.28);
    --acc: #ff4a1c;
    --acc-ink: #c23409;

    background: var(--paper);
    color: var(--ink);
    font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
    font-size: 16px;
    letter-spacing: -0.01em;
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .stu-wrap {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 28px;
  }

  /* ---------- cursor ---------- */
  .stu-cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 9998;
    pointer-events: none;
    display: none;
    opacity: 0;
    will-change: transform;
  }

  .stu-cursor.is-on {
    display: block;
  }

  .stu-cursor span {
    display: block;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border-radius: 50%;
    border: 1.5px solid var(--acc);
    mix-blend-mode: multiply;
  }

  html.embed .stu-cursor {
    display: none;
  }

  /* ---------- nav ---------- */
  .stu-nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(242, 240, 235, 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .stu-nav__in {
    display: flex;
    align-items: center;
    gap: 40px;
    height: 68px;
  }

  .stu-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-weight: 800;
    font-size: 18px;
    letter-spacing: -0.04em;
    flex: none;
  }

  .stu-brand__mark {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 3px;
    background: var(--ink);
    color: var(--paper);
    font-size: 13px;
  }

  .stu-nav__links {
    display: flex;
    gap: 30px;
    margin-inline: auto;
  }

  .stu-nav__links a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-size: 14px;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .stu-nav__links a:hover {
    color: var(--acc-ink);
  }

  .stu-nav__links em {
    font-style: normal;
    font-size: 10px;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  /* ---------- buttons ---------- */
  .stu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    height: 50px;
    padding: 0 26px;
    border-radius: 2px;
    background: var(--ink);
    color: var(--paper);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.22s ease, color 0.22s ease, transform 0.22s ease;
  }

  .stu-btn:hover {
    background: var(--acc);
    color: #fff;
    transform: translateY(-2px);
  }

  .stu-btn--sm {
    height: 40px;
    padding: 0 18px;
    font-size: 14px;
    flex: none;
  }

  .stu-btn--lg {
    height: 62px;
    padding: 0 34px;
    font-size: 17px;
  }

  .stu-btn--out {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  .stu-btn--out:hover {
    background: var(--ink);
    color: var(--paper);
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  .stu-btn--full {
    width: 100%;
  }

  .stu-link {
    font-size: 15px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1.5px solid var(--line-2);
    padding-bottom: 3px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .stu-link:hover {
    color: var(--acc-ink);
    border-color: var(--acc);
  }

  /* ---------- hero ---------- */
  .stu-hero {
    padding-top: 92px;
  }

  .stu-hero__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 34px;
  }

  .stu-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acc);
  }

  .stu-hero__year {
    margin-left: auto;
  }

  .stu-h1 {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: clamp(2.9rem, 8.6vw, 8rem);
    line-height: 0.9;
    font-weight: 800;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .stu-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
    margin-right: 0.22em;
  }

  .stu-word > span {
    display: inline-block;
  }

  html.js .stu-word > span {
    transform: translateY(112%);
  }

  .stu-word--acc > span {
    color: var(--acc);
  }

  .stu-hero__row {
    margin-top: 52px;
    padding-bottom: 62px;
    display: grid;
    grid-template-columns: 1fr 0.82fr;
    gap: 60px;
    align-items: start;
  }

  .stu-hero__sub {
    font-size: clamp(1.02rem, 1.5vw, 1.24rem);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 48ch;
  }

  .stu-hero__act {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .stu-hero__note {
    flex-basis: 100%;
    font-size: 13px;
    color: var(--ink-3);
  }

  /* ---------- marquee ---------- */
  .stu-marq {
    border-block: 1px solid var(--ink);
    background: var(--ink);
