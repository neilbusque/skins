---
/**
 * SKIN: AG1 Long-Form Science Sales  ·  swipe ref: ag1-longform  ·  archetype: Long-Form Sales
 *
 * Warm sand and bone bands, deep forest green brand, muted gold accent, Fraunces
 * for the emotional headlines and Inter for everything that has to look clinical.
 * The layout carries the funnel: quiz entry, problem, mechanism, ingredient panel,
 * numbers, press, reviews, offer, guarantee, FAQ, close. Motion is calm, never bouncy.
 */
import { content as c } from '../../lib/content';

const year = 2026;

const stars = [0, 1, 2, 3, 4];
const seal = Array.from({ length: 24 }, (_, i) => i * 15);

const featured = c.pricing.plans.find((p) => p.featured) ?? c.pricing.plans[0];
const countStat = c.stats.find((s) => s.value.includes('+')) ?? c.stats[c.stats.length - 1];
const badgeStat = c.stats[0];

const steps = c.showcase.bullets.slice(0, 3);
const restBullets = c.showcase.bullets.slice(3);
const stepLabels = ['Step one', 'Step two', 'Step three'];
---

<div class="lf">
  <div class="lf-announce">
    <div class="lf-wrap lf-announce__in">
      <span class="lf-announce__dot" aria-hidden="true"></span>
      <span>{c.hero.note}</span>
    </div>
  </div>

  <header class="lf-nav">
    <div class="lf-wrap lf-nav__in">
      <a class="lf-brand" href="#">
        <span class="lf-brand__mark">{c.brand.mark}</span>
        <span class="lf-brand__name">{c.brand.name}</span>
      </a>
      <nav class="lf-nav__links" aria-label="Primary">
        {c.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="lf-nav__act">
        <a class="lf-nav__login" href="#">Log in</a>
        <a class="lf-btn lf-btn--sm" href={c.nav.cta.href}>{c.nav.cta.label}</a>
      </div>
    </div>
  </header>

  <section class="lf-hero">
    <div class="lf-hero__wash" aria-hidden="true"></div>
    <div class="lf-wrap lf-hero__in">
      <div class="lf-hero__copy">
        <p class="lf-eyebrow" data-reveal>{c.hero.eyebrow}</p>
        <h1 class="lf-h1" data-reveal style="--reveal-delay:60ms">
          {c.hero.headline}
          <span class="lf-h1__accent">{c.hero.headlineAccent}</span>
        </h1>
        <p class="lf-lead" data-reveal style="--reveal-delay:120ms">{c.hero.sub}</p>

        <div class="lf-hero__cta" data-reveal style="--reveal-delay:180ms">
          <a class="lf-btn lf-btn--lg" href={c.hero.ctaPrimary.href}>{c.hero.ctaPrimary.label}</a>
          <a class="lf-link" href={c.hero.ctaSecondary.href}>
            {c.hero.ctaSecondary.label}
            <span aria-hidden="true">&rsaquo;</span>
          </a>
        </div>

        <div class="lf-rating" data-reveal style="--reveal-delay:240ms">
          <span class="lf-stars" aria-hidden="true">
            {
              stars.map(() => (
                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 1.6l2.4 5.3 5.8.6-4.3 3.9 1.2 5.7L10 14.2 4.9 17.1l1.2-5.7L1.8 7.5l5.8-.6z" />
                </svg>
              ))
            }
          </span>
          <span class="lf-rating__txt">
            <strong>{countStat.value}</strong>
            {countStat.label}
          </span>
        </div>
      </div>

      <div class="lf-hero__vis" data-reveal style="--reveal-delay:300ms">
        <div class="lf-plinth" aria-hidden="true"></div>
        <div class="lf-obj">
          <span class="lf-obj__lid" aria-hidden="true"></span>
          <span class="lf-obj__neck" aria-hidden="true"></span>
          <div class="lf-obj__body">
            <div class="lf-obj__label">
              <span class="lf-obj__mark">{c.brand.mark}</span>
              <strong class="lf-obj__name">{c.brand.name}</strong>
              <span class="lf-obj__rule" aria-hidden="true"></span>
              <span class="lf-obj__tag">{c.brand.tagline}</span>
              <span class="lf-obj__dom">{c.brand.domain}</span>
            </div>
            <span class="lf-obj__gloss" aria-hidden="true"></span>
          </div>
          <span class="lf-obj__shadow" aria-hidden="true"></span>
        </div>
        <div class="lf-badge">
          <strong>{badgeStat.value}</strong>
          <span>{badgeStat.label}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="lf-logos">
    <div class="lf-wrap">
      <p class="lf-logos__label" data-reveal>{c.logos.label}</p>
      <div class="lf-logos__row" data-reveal style="--reveal-delay:80ms">
        {c.logos.items.map((n) => <span class="lf-logos__item">{n}</span>)}
      </div>
    </div>
  </section>

  <section class="lf-sec lf-sec--sand">
    <div class="lf-wrap">
      <div class="lf-head lf-head--center" data-reveal>
        <p class="lf-eyebrow">{c.problem.eyebrow}</p>
        <h2 class="lf-h2">{c.problem.headline}</h2>
        <p class="lf-lead">{c.problem.body}</p>
      </div>
      <div class="lf-probs">
        {
          c.problem.points.map((p, i) => (
            <article class="lf-prob" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="lf-prob__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="lf-prob__t">{p.title}</h3>
              <p class="lf-prob__b">{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="lf-sec lf-sec--bone" id="showcase">
    <div class="lf-wrap">
      <div class="lf-head lf-head--center" data-reveal>
        <p class="lf-eyebrow">{c.showcase.eyebrow}</p>
        <h2 class="lf-h2">{c.showcase.headline}</h2>
        <p class="lf-lead">{c.showcase.body}</p>
      </div>

      <div class="lf-steps">
        <span class="lf-steps__line" aria-hidden="true"></span>
        {
          steps.map((b, i) => (
            <div class="lf-step" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="lf-step__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="lf-step__k">{stepLabels[i]}</span>
              <p class="lf-step__b">{b}</p>
            </div>
          ))
        }
      </div>

      {
        restBullets.length > 0 && (
          <ul class="lf-steps__note" data-reveal style="--reveal-delay:280ms">
            {restBullets.map((b) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path
                    d="m2.8 7.2 2.8 2.8 5.6-6"
                    stroke="currentColor"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {b}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <section class="lf-sec lf-sec--sand" id="features">
    <div class="lf-wrap">
      <div class="lf-head lf-head--center" data-reveal>
        <p class="lf-eyebrow">{c.features.eyebrow}</p>
        <h2 class="lf-h2">{c.features.headline}</h2>
      </div>

      <div class="lf-panel" data-reveal style="--reveal-delay:80ms">
        <div class="lf-panel__head">
          <span class="lf-panel__label">{c.features.eyebrow}</span>
          <span class="lf-panel__sub">{c.features.sub}</span>
        </div>
        <div class="lf-panel__rows">
          {
            c.features.items.map((f) => (
              <article class="lf-ing">
                <span class="lf-ing__g" aria-hidden="true">
                  {f.glyph}
                </span>
                <div>
                  <h3 class="lf-ing__t">{f.title}</h3>
                  <p class="lf-ing__b">{f.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="lf-stats">
    <div class="lf-wrap lf-stats__row">
      {
        c.stats.map((s, i) => (
          <div class="lf-stat" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <strong class="lf-stat__v" data-count>
              {s.value}
            </strong>
            <span class="lf-stat__l">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="lf-press">
    <div class="lf-wrap lf-press__in">
      <blockquote class="lf-press__quote" data-reveal>
        <span class="lf-press__mark" aria-hidden="true">&ldquo;</span>
        {c.problem.body}
      </blockquote>
      <div class="lf-press__seen" data-reveal style="--reveal-delay:100ms">
        <p class="lf-press__label">As seen in</p>
        <div class="lf-press__row">
          {c.logos.items.map((n) => <span class="lf-press__name">{n}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="lf-sec lf-sec--bone" id="proof">
    <div class="lf-wrap">
      <div class="lf-head lf-head--center" data-reveal>
        <div class="lf-rating lf-rating--center">
          <span class="lf-stars" aria-hidden="true">
            {
              stars.map(() => (
                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 1.6l2.4 5.3 5.8.6-4.3 3.9 1.2 5.7L10 14.2 4.9 17.1l1.2-5.7L1.8 7.5l5.8-.6z" />
                </svg>
              ))
            }
          </span>
          <span class="lf-rating__txt">
            <strong>{countStat.value}</strong>
            {countStat.label}
          </span>
        </div>
        <h2 class="lf-h2">Reviews</h2>
      </div>

      <div class="lf-reviews">
        {
          c.testimonials.map((t, i) => (
            <figure class="lf-review" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="lf-stars lf-stars--sm" aria-hidden="true">
                {stars.map(() => (
                  <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 1.6l2.4 5.3 5.8.6-4.3 3.9 1.2 5.7L10 14.2 4.9 17.1l1.2-5.7L1.8 7.5l5.8-.6z" />
                  </svg>
                ))}
              </span>
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="lf-review__av" aria-hidden="true">
                  {t.name.charAt(0)}
                </span>
                <span class="lf-review__who">
                  <strong>{t.name}</strong>
                  <em>
                    {t.role}, {t.company}
                  </em>
                </span>
                <span class="lf-review__ver">
                  <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="m2.8 7.2 2.8 2.8 5.6-6"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  Verified
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="lf-sec lf-sec--sand" id="pricing">
    <div class="lf-wrap">
      <div class="lf-head lf-head--center" data-reveal>
        <p class="lf-eyebrow">{c.pricing.eyebrow}</p>
        <h2 class="lf-h2">{c.pricing.headline}</h2>
        <p class="lf-lead">{c.pricing.sub}</p>
      </div>

      <div class="lf-plans">
        {
          c.pricing.plans.map((p, i) => (
            <article
              class:list={['lf-plan', { 'is-feat': p.featured }]}
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
            >
              {p.featured && <span class="lf-plan__tag">{c.hero.eyebrow}</span>}
              <h3 class="lf-plan__n">{p.name}</h3>
              <p class="lf-plan__blurb">{p.blurb}</p>
              <p class="lf-plan__price">
                <strong>{p.price}</strong>
                <span>{p.period}</span>
              </p>
              <a
                class:list={['lf-btn', 'lf-btn--full', { 'lf-btn--ghost': !p.featured }]}
                href="#cta"
              >
                {p.cta}
              </a>
              <ul class="lf-plan__list">
                {p.features.map((f) => (
                  <li>
                    <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path
                        d="m2.8 7.2 2.8 2.8 5.6-6"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="lf-guar">
    <div class="lf-wrap lf-guar__in">
      <div class="lf-guar__sealWrap" data-reveal>
        <svg class="lf-seal" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
          <circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="1" opacity=".38"
          ></circle>
          {
            seal.map((a) => (
              <line
                x1="60"
                y1="4"
                x2="60"
                y2="11"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                opacity=".55"
                transform={`rotate(${a} 60 60)`}
              />
            ))
          }
          <circle cx="60" cy="60" r="47" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <circle
            cx="60"
            cy="60"
            r="40"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-dasharray="1.5 6"
            stroke-linecap="round"
            opacity=".7"></circle>
          <path
            d="M34 82a36 36 0 0 1 0-44"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            opacity=".5"></path>
          <path
            d="M86 82a36 36 0 0 0 0-44"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            opacity=".5"></path>
          <path
            d="M45 61.5 55 71.5 76 48"
            fill="none"
            stroke="currentColor"
            stroke-width="5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
      <div class="lf-guar__copy" data-reveal style="--reveal-delay:100ms">
        <h2 class="lf-h2 lf-h2--light">{c.guarantee.headline}</h2>
        <p class="lf-guar__b">{c.guarantee.body}</p>
      </div>
    </div>
  </section>

  <section class="lf-sec lf-sec--bone">
    <div class="lf-wrap lf-faq">
      <div class="lf-faq__head" data-reveal>
        <p class="lf-eyebrow">{c.faqHead.eyebrow}</p>
        <h2 class="lf-h2">{c.faqHead.headline}</h2>
      </div>
      <div class="lf-faq__list" data-reveal style="--reveal-delay:80ms">
        {
          c.faq.map((f, i) => (
            <details class="lf-faq__item" open={i === 0}>
              <summary>
                <span>{f.q}</span>
                <span class="lf-faq__ico" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="lf-sec lf-sec--sand lf-sec--close" id="cta">
    <div class="lf-wrap">
      <div class="lf-close" data-reveal>
        <span class="lf-close__rule" aria-hidden="true"></span>
        <h2 class="lf-h2 lf-h2--light lf-h2--big">{c.cta.headline}</h2>
        <p class="lf-close__sub">{c.cta.sub}</p>
        <a class="lf-btn lf-btn--lg lf-btn--gold" href={c.cta.button.href}>{c.cta.button.label}</a>
        <p class="lf-close__note">{c.cta.note}</p>
        <div class="lf-close__rating">
          <span class="lf-stars lf-stars--sm" aria-hidden="true">
            {
              stars.map(() => (
                <svg width="13" height="13" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 1.6l2.4 5.3 5.8.6-4.3 3.9 1.2 5.7L10 14.2 4.9 17.1l1.2-5.7L1.8 7.5l5.8-.6z" />
                </svg>
              ))
            }
          </span>
          <span>
            {countStat.value} {countStat.label}
          </span>
        </div>
      </div>
    </div>
  </section>

  <footer class="lf-foot">
    <div class="lf-wrap lf-foot__in">
      <div class="lf-foot__brand">
        <a class="lf-brand" href="#">
          <span class="lf-brand__mark">{c.brand.mark}</span>
          <span class="lf-brand__name">{c.brand.name}</span>
        </a>
        <p>{c.brand.tagline}</p>
        <p class="lf-foot__dom">{c.brand.domain}</p>
      </div>
      {
        c.footer.columns.map((col) => (
          <div class="lf-foot__col">
            <h3>{col.title}</h3>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="lf-wrap lf-foot__legal">
      <span>&copy; {year} {c.brand.name}</span>
      <span>{c.footer.legal}</span>
    </div>
  </footer>

  <div class="lf-sticky" data-lf-sticky>
    <div class="lf-wrap lf-sticky__in">
      <span class="lf-sticky__brand">
        <span class="lf-brand__mark">{c.brand.mark}</span>
        <span class="lf-sticky__name">{c.brand.name}</span>
      </span>
      <span class="lf-sticky__price">
        <strong>{featured.price}</strong>
        <em>{featured.period}</em>
      </span>
      <a class="lf-btn lf-btn--sticky" href={c.hero.ctaPrimary.href}>{c.hero.ctaPrimary.label}</a>
    </div>
  </div>

  <div
    class="lf-quiz"
    data-lf-quiz
    role="dialog"
    aria-modal="true"
    aria-labelledby="lf-quiz-title"
    hidden
  >
    <div class="lf-quiz__scrim" data-lf-quiz-close aria-hidden="true"></div>
    <div class="lf-quiz__card" role="document">
      <button class="lf-quiz__x" type="button" data-lf-quiz-close aria-label="Close this question">
        <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path
            d="M3 3l8 8M11 3l-8 8"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
      <p class="lf-quiz__step">Step 1 of 1</p>
      <p class="lf-quiz__eyebrow">{c.problem.eyebrow}</p>
      <h2 class="lf-quiz__t" id="lf-quiz-title">{c.problem.headline}</h2>
      <div class="lf-quiz__opts">
        {
          c.problem.points.map((p, i) => (
            <button class="lf-quiz__opt" type="button" data-lf-quiz-close>
              <span class="lf-quiz__key" aria-hidden="true">
                {String.fromCharCode(65 + i)}
              </span>
              <span class="lf-quiz__optT">{p.title}</span>
              <span class="lf-quiz__arrow" aria-hidden="true">
                &rsaquo;
              </span>
            </button>
          ))
        }
      </div>
      <button class="lf-quiz__skip" type="button" data-lf-quiz-close>Skip for now</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    /* ---- quiz entry modal ---- */
    var KEY = 'lf-quiz-seen-v1';
    var modal = document.querySelector('[data-lf-quiz]');
    if (modal) {
      var opener = null;
      var seen = false;
      try {
        seen = sessionStorage.getItem(KEY) === '1';
      } catch (e) {
        seen = false;
      }

      var onKey = function (e) {
        if (e.key === 'Escape') {
          closeQuiz();
          return;
        }
        if (e.key !== 'Tab') return;
        var f = modal.querySelectorAll('button');
        if (!f.length) return;
        var first = f[0];
        var last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      };

      var closeQuiz = function () {
        if (modal.hidden) return;
        modal.classList.remove('is-open');
        document.removeEventListener('keydown', onKey);
        document.documentElement.style.removeProperty('overflow');
        try {
          sessionStorage.setItem(KEY, '1');
        } catch (e) {}
        window.setTimeout(function () {
          modal.hidden = true;
        }, 320);
        if (opener && opener.focus) opener.focus();
      };

      var openQuiz = function () {
        opener = document.activeElement;
        modal.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        window.requestAnimationFrame(function () {
          modal.classList.add('is-open');
        });
        document.addEventListener('keydown', onKey);
        var first = modal.querySelector('.lf-quiz__opt');
        if (first) first.focus({ preventScroll: true });
      };

      modal.addEventListener('click', function (e) {
        var t = e.target;
        if (t && t.closest && t.closest('[data-lf-quiz-close]')) closeQuiz();
      });

      if (!seen) window.setTimeout(openQuiz, 900);
    }

    /* ---- sticky CTA, shown once the hero has scrolled past ---- */
    var hero = document.querySelector('.lf-hero');
    var bar = document.querySelector('[data-lf-sticky]');
    if (hero && bar) {
      if ('IntersectionObserver' in window) {
        var sio = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) bar.classList.remove('is-on');
              else bar.classList.add('is-on');
            });
          },
          { threshold: 0 }
        );
        sio.observe(hero);
      } else {
        bar.classList.add('is-on');
      }
    }

    /* ---- stat count-up. Real values are already in the HTML. ---- */
    var nums = document.querySelectorAll('[data-count]');
    if (!nums.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;

    var run = function (el) {
      var raw = (el.textContent || '').trim();
      var m = raw.match(/^([^0-9]*)([0-9][0-9,.]*)([\s\S]*)$/);
      if (!m) return;
      var pre = m[1];
      var numStr = m[2];
      var post = m[3];
      var clean = numStr.replace(/,/g, '');
      var target = parseFloat(clean);
      if (!isFinite(target)) return;
      var dec = (clean.split('.')[1] || '').length;
      var grouped = numStr.indexOf(',') > -1;
      var dur = 1200;
      var t0 = 0;

      var fmt = function (v) {
        var s = v.toFixed(dec);
        if (grouped)
          s = Number(s).toLocaleString('en-US', {
            minimumFractionDigits: dec,
            maximumFractionDigits: dec,
          });
        return pre + s + post;
      };

      var step = function (ts) {
        if (!t0) t0 = ts;
        var p = Math.min((ts - t0) / dur, 1);
        var e = 1 - Math.pow(1 - p, 3);
        if (p < 1) {
          el.textContent = fmt(target * e);
          window.requestAnimationFrame(step);
        } else {
          el.textContent = raw;
        }
      };

      window.requestAnimationFrame(step);
    };

    var nio = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          nio.unobserve(entry.target);
          run(entry.target);
        });
      },
      { threshold: 0.45 }
    );
    nums.forEach(function (el) {
      nio.observe(el);
    });
  })();
</script>

