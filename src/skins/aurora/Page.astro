---
/**
 * SKIN: Aurora  ·  archetype: Glass Bento  ·  motion: GSAP
 *
 * The current Framer template look. Near-black base under a slow animated mesh,
 * glass surfaces with hairline borders, generous radii, and an asymmetric bento
 * grid doing the heavy lifting for features.
 *
 * Layout engine: BENTO. Nothing else in the library uses a spanning grid.
 * Motion: mesh drift, masked word reveal, marquee, tile stagger, counting stats,
 * magnetic primary button. All GSAP, all released from [data-anim].
 */
import { content as c } from '../../lib/content';

const year = 2026;
const headWords = c.hero.headline.split(' ');
const accentWords = c.hero.headlineAccent.split(' ');
const marquee = [...c.logos.items, ...c.logos.items];
---

<div class="aur">
  <div class="aur-mesh" aria-hidden="true">
    <span class="aur-mesh__blob aur-mesh__blob--a"></span>
    <span class="aur-mesh__blob aur-mesh__blob--b"></span>
    <span class="aur-mesh__blob aur-mesh__blob--c"></span>
  </div>
  <div class="aur-grid-lines" aria-hidden="true"></div>

  <header class="aur-nav">
    <div class="aur-nav__pill">
      <a class="aur-brand" href="#">
        <span class="aur-brand__mark">{c.brand.mark}</span>
        <span class="aur-brand__name">{c.brand.name}</span>
      </a>
      <nav class="aur-nav__links" aria-label="Primary">
        {c.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <a class="aur-btn aur-btn--sm" href={c.nav.cta.href}>{c.nav.cta.label}</a>
    </div>
  </header>

  <section class="aur-hero">
    <div class="aur-wrap aur-hero__in">
      <a class="aur-pill" href="#" data-anim>
        <span class="aur-pill__dot"></span>
        {c.hero.eyebrow}
        <span class="aur-pill__go">&rsaquo;</span>
      </a>

      <h1 class="aur-h1" aria-label={`${c.hero.headline} ${c.hero.headlineAccent}`}>
        {
          headWords.map((w) => (
            <span class="aur-word" data-anim>
              <span>{w}</span>
            </span>
          ))
        }
        <br />
        {
          accentWords.map((w) => (
            <span class="aur-word aur-word--acc" data-anim>
              <span>{w}</span>
            </span>
          ))
        }
      </h1>

      <p class="aur-sub" data-anim>{c.hero.sub}</p>

      <div class="aur-hero__cta" data-anim>
        <a class="aur-btn aur-btn--mag" href={c.hero.ctaPrimary.href}>
          <span>{c.hero.ctaPrimary.label}</span>
        </a>
        <a class="aur-btn aur-btn--ghost" href={c.hero.ctaSecondary.href}>
          {c.hero.ctaSecondary.label}
        </a>
      </div>

      <p class="aur-note" data-anim>{c.hero.note}</p>

      <div class="aur-panel" data-anim>
        <div class="aur-panel__bar">
          <span class="aur-panel__dots"><i></i><i></i><i></i></span>
          <span class="aur-panel__url">{c.brand.domain}</span>
        </div>
        <div class="aur-panel__body">
          <div class="aur-panel__side">
            {
              ['Overview', 'Clients', 'Approvals', 'Billing', 'Capacity'].map((s, i) => (
                <span class:list={['aur-panel__nav', { 'is-on': i === 0 }]}>{s}</span>
              ))
            }
          </div>
          <div class="aur-panel__main">
            <div class="aur-panel__cards">
              {
                [
                  ['This week', '18 open', 62],
                  ['Awaiting client', '5 items', 34],
                  ['Ready to bill', '$41,200', 88],
                ].map(([t, v, pct]) => (
                  <div class="aur-panel__card">
                    <em>{t}</em>
                    <strong>{v}</strong>
                    <span class="aur-panel__meter">
                      <i style={`--pct:${pct}%`} />
                    </span>
                  </div>
                ))
              }
            </div>
            <div class="aur-panel__chart">
              {
                [38, 54, 44, 68, 59, 82, 71, 92, 76, 88, 96, 84].map((h, i) => (
                  <span class="aur-panel__bar" style={`--h:${h}%; --i:${i}`} />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="aur-marq" aria-label={c.logos.label}>
    <p class="aur-marq__label" data-anim>{c.logos.label}</p>
    <div class="aur-marq__mask">
      <div class="aur-marq__track">
        {marquee.map((n) => <span class="aur-marq__item">{n}</span>)}
      </div>
    </div>
  </section>

  <section class="aur-sec">
    <div class="aur-wrap">
      <div class="aur-head">
        <p class="aur-eyebrow" data-anim>{c.problem.eyebrow}</p>
        <h2 class="aur-h2" data-anim>{c.problem.headline}</h2>
        <p class="aur-lead" data-anim>{c.problem.body}</p>
      </div>
      <div class="aur-three">
        {
          c.problem.points.map((p, i) => (
            <article class="aur-glass aur-prob" data-anim data-stagger>
              <span class="aur-prob__n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="aur-sec" id="features">
    <div class="aur-wrap">
      <div class="aur-head">
        <p class="aur-eyebrow" data-anim>{c.features.eyebrow}</p>
        <h2 class="aur-h2" data-anim>{c.features.headline}</h2>
        <p class="aur-lead" data-anim>{c.features.sub}</p>
      </div>

      <div class="aur-bento">
        {
          c.features.items.map((f, i) => (
            <article class={`aur-glass aur-tile aur-tile--${i + 1}`} data-anim data-stagger>
              <span class="aur-tile__glyph">{f.glyph}</span>
              <h3 class="aur-tile__t">{f.title}</h3>
              <p class="aur-tile__b">{f.body}</p>
              {i === 0 && (
                <div class="aur-tile__vis" aria-hidden="true">
                  {['Northline', 'Halcyon', 'Fielder & Co', 'Brightpath'].map((n, j) => (
                    <span class="aur-tile__row">
                      <i class="aur-tile__av">{n.charAt(0)}</i>
                      <em>{n}</em>
                      <b class:list={['aur-tile__tag', { 'is-live': j < 2 }]}>{j < 2 ? 'Live' : 'Draft'}</b>
                    </span>
                  ))}
                </div>
              )}
              {i === 1 && (
                <div class="aur-tile__ring" aria-hidden="true">
                  <svg viewBox="0 0 84 84" width="84" height="84">
                    <circle cx="42" cy="42" r="34" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="8" />
                    <circle
                      class="aur-tile__ringArc"
                      cx="42"
                      cy="42"
                      r="34"
                      fill="none"
                      stroke="url(#aurRing)"
                      stroke-width="8"
                      stroke-linecap="round"
                      stroke-dasharray="214"
                      stroke-dashoffset="64"
                      transform="rotate(-90 42 42)"
                    />
                    <defs>
                      <linearGradient id="aurRing" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#a78bfa" />
                        <stop offset="1" stop-color="#22d3ee" />
                      </linearGradient>
                    </defs>
                  </svg>
                  <span>70%</span>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="aur-sec" id="showcase">
    <div class="aur-wrap aur-split">
      <div class="aur-split__copy">
        <p class="aur-eyebrow" data-anim>{c.showcase.eyebrow}</p>
        <h2 class="aur-h2" data-anim>{c.showcase.headline}</h2>
        <p class="aur-lead" data-anim>{c.showcase.body}</p>
        <ul class="aur-checks">
          {
            c.showcase.bullets.map((b) => (
              <li data-anim data-stagger>
                <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path
                    d="m2.8 7.2 2.8 2.8 5.6-6"
                    stroke="currentColor"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {b}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="aur-split__vis" data-anim>
        <div class="aur-orbit">
          <span class="aur-orbit__core">{c.brand.mark}</span>
          <span class="aur-orbit__ring aur-orbit__ring--1"></span>
          <span class="aur-orbit__ring aur-orbit__ring--2"></span>
          {
            ['Workspace', 'Slack', 'Stripe', 'Drive'].map((n, i) => (
              <span class={`aur-orbit__node aur-orbit__node--${i + 1}`}>{n}</span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="aur-stats">
    <div class="aur-wrap aur-stats__row">
      {
        c.stats.map((s) => (
          <div class="aur-stat" data-anim data-stagger>
            <strong data-count={s.value}>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="aur-sec" id="proof">
    <div class="aur-wrap">
      <div class="aur-head">
        <p class="aur-eyebrow" data-anim>{c.proof.eyebrow}</p>
        <h2 class="aur-h2" data-anim>{c.proof.headline}</h2>
      </div>
      <div class="aur-three">
        {
          c.testimonials.map((t) => (
            <figure class="aur-glass aur-quote" data-anim data-stagger>
              <span class="aur-quote__mark" aria-hidden="true">&ldquo;</span>
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="aur-quote__av">{t.name.charAt(0)}</span>
                <span>
                  <strong>{t.name}</strong>
                  <em>{t.role}, {t.company}</em>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="aur-sec" id="pricing">
    <div class="aur-wrap">
      <div class="aur-head">
        <p class="aur-eyebrow" data-anim>{c.pricing.eyebrow}</p>
        <h2 class="aur-h2" data-anim>{c.pricing.headline}</h2>
        <p class="aur-lead" data-anim>{c.pricing.sub}</p>
      </div>
      <div class="aur-plans">
        {
          c.pricing.plans.map((p) => (
            <article class:list={['aur-glass', 'aur-plan', { 'is-feat': p.featured }]} data-anim data-stagger>
              {p.featured && <span class="aur-plan__tag">Most teams</span>}
              <h3 class="aur-plan__n">{p.name}</h3>
              <p class="aur-plan__blurb">{p.blurb}</p>
              <p class="aur-plan__price">
                <strong>{p.price}</strong>
                <em>{p.period}</em>
              </p>
              <a class:list={['aur-btn', 'aur-btn--full', { 'aur-btn--ghost': !p.featured }]} href="#cta">
                {p.cta}
              </a>
              <ul class="aur-plan__feat">
                {p.features.map((f) => (
                  <li>
                    <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path
                        d="m2.8 7.2 2.8 2.8 5.6-6"
                        stroke="currentColor"
                        stroke-width="1.9"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="aur-glass aur-guar" data-anim>
        <h3>{c.guarantee.headline}</h3>
        <p>{c.guarantee.body}</p>
      </div>
    </div>
  </section>

  <section class="aur-sec">
    <div class="aur-wrap aur-faq">
      <div class="aur-faq__head">
        <p class="aur-eyebrow" data-anim>{c.faqHead.eyebrow}</p>
        <h2 class="aur-h2" data-anim>{c.faqHead.headline}</h2>
      </div>
      <div class="aur-faq__list" data-anim>
        {
          c.faq.map((f, i) => (
            <details class="aur-faq__item" open={i === 0}>
              <summary>
                {f.q}
                <span class="aur-faq__ico" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="aur-cta" id="cta">
    <div class="aur-cta__glow" aria-hidden="true"></div>
    <div class="aur-wrap aur-cta__in">
      <h2 class="aur-h1 aur-h1--sm" data-anim>{c.cta.headline}</h2>
      <p class="aur-sub" data-anim>{c.cta.sub}</p>
      <div class="aur-hero__cta" data-anim>
        <a class="aur-btn aur-btn--mag" href={c.cta.button.href}>
          <span>{c.cta.button.label}</span>
        </a>
      </div>
      <p class="aur-note" data-anim>{c.cta.note}</p>
    </div>
  </section>

  <footer class="aur-foot">
    <div class="aur-wrap aur-foot__in">
      <div class="aur-foot__brand">
        <a class="aur-brand" href="#">
          <span class="aur-brand__mark">{c.brand.mark}</span>
          <span class="aur-brand__name">{c.brand.name}</span>
        </a>
        <p>{c.brand.tagline}</p>
      </div>
      {
        c.footer.columns.map((col) => (
          <div class="aur-foot__col">
            <h4>{col.title}</h4>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="aur-wrap aur-foot__legal">
      <span>&copy; {year} {c.brand.name}</span>
      <span>{c.footer.legal}</span>
    </div>
  </footer>
</div>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector('.aur');
  if (root) {
    const q = (sel) => Array.from(root.querySelectorAll(sel));
    const anims = q('[data-anim]');
    const words = q('.aur-word > span');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced) {
      /* CSS already releases [data-anim] under reduced motion. The masked words
         are a transform, so they need releasing here too. */
      gsap.set(anims, { opacity: 1, y: 0 });
      gsap.set(words, { y: 0 });
    } else {
      const heroAnims = q('.aur-hero [data-anim]');
      const heroSet = new Set(heroAnims);

      /* ---- hero ---- */
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.fromTo('.aur-pill', { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: 0.7 })
        .to('.aur-word', { opacity: 1, duration: 0.01, stagger: 0.042 }, 0.14)
        .to('.aur-word > span', { y: '0%', duration: 1.05, stagger: 0.042, ease: 'expo.out' }, 0.14)
        .fromTo('.aur-sub', { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: 0.8 }, 0.5)
        .fromTo('.aur-hero .aur-hero__cta', { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: 0.8 }, 0.58)
        .fromTo('.aur-hero .aur-note', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.7 }, 0.66)
        .fromTo(
          '.aur-panel',
          { opacity: 0, y: 56, rotateX: 9, transformPerspective: 1200 },
          { opacity: 1, y: 0, rotateX: 0, duration: 1.2 },
          0.62
        );

      gsap.fromTo(
        '.aur-panel__bar i, .aur-panel__meter i',
        { scaleX: 0 },
        { scaleX: 1, transformOrigin: 'left center', duration: 1.1, stagger: 0.08, ease: 'power2.out', delay: 1.1 }
      );

      /* ---- everything below the fold ----
         batchMax and the stagger are deliberately tight. A single column phone
         layout drops twenty elements into one batch, and a long cascade leaves
         the tail of it sitting at exactly opacity 0 for seconds after the
         trigger fired. Keep the whole tail under about 0.8s. */
      ScrollTrigger.batch(
        anims.filter((el) => !heroSet.has(el)),
        {
          start: 'top 90%',
          once: true,
          batchMax: 4,
          onEnter: (batch) =>
            gsap.fromTo(
              batch,
              { opacity: 0, y: 30 },
              { opacity: 1, y: 0, duration: 0.65, stagger: 0.05, ease: 'power3.out', overwrite: 'auto' }
            ),
        }
      );

      /* ---- ambient mesh ---- */
      const drift = [
        ['.aur-mesh__blob--a', 13, -11, 1.16, 15],
        ['.aur-mesh__blob--b', -12, 14, 1.1, 19],
        ['.aur-mesh__blob--c', 9, 12, 1.2, 23],
      ];
      drift.forEach(([sel, x, y, s, d]) => {
        gsap.to(sel, {
          xPercent: x,
          yPercent: y,
          scale: s,
          duration: d,
          ease: 'sine.inOut',
          repeat: -1,
          yoyo: true,
        });
      });

      /* ---- logo marquee. The track holds the list twice, so -50% is seamless ---- */
      const track = root.querySelector('.aur-marq__track');
      if (track) gsap.to(track, { xPercent: -50, duration: 30, ease: 'none', repeat: -1 });

      /* ---- orbit rings ---- */
      gsap.to('.aur-orbit__ring--1', { rotate: 360, duration: 34, ease: 'none', repeat: -1 });
      gsap.to('.aur-orbit__ring--2', { rotate: -360, duration: 46, ease: 'none', repeat: -1 });

      /* ---- parallax. Transform only. A scrubbed opacity would leave content
             invisible whenever the page is scrolled back to the top ---- */
      gsap.to('.aur-panel', {
        yPercent: -5,
        ease: 'none',
        scrollTrigger: { trigger: '.aur-hero', start: 'top top', end: 'bottom top', scrub: 0.6 },
      });

      /* ---- bento ring arc ---- */
      const arc = root.querySelector('.aur-tile__ringArc');
      if (arc) {
        ScrollTrigger.create({
          trigger: arc,
          start: 'top 92%',
          once: true,
          onEnter: () => gsap.fromTo(arc, { strokeDashoffset: 214 }, { strokeDashoffset: 64, duration: 1.4, ease: 'power2.out' }),
        });
      }

      /* ---- magnetic primary button ---- */
      if (!window.matchMedia('(hover: none)').matches) {
        q('.aur-btn--mag').forEach((btn) => {
          const label = btn.querySelector('span');
          btn.addEventListener('pointermove', (e) => {
            const r = btn.getBoundingClientRect();
            const x = e.clientX - r.left - r.width / 2;
            const y = e.clientY - r.top - r.height / 2;
            gsap.to(btn, { x: x * 0.3, y: y * 0.36, duration: 0.5, ease: 'power3.out' });
            if (label) gsap.to(label, { x: x * 0.12, y: y * 0.14, duration: 0.5, ease: 'power3.out' });
          });
          btn.addEventListener('pointerleave', () => {
            gsap.to([btn, label].filter(Boolean), { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.45)' });
          });
        });
      }
    }

    /* ---- counting stats. Runs under reduced motion too, just instantly ---- */
    q('[data-count]').forEach((el) => {
      const raw = el.getAttribute('data-count') || '';
      const m = raw.match(/^(\D*)([\d.,]+)(.*)$/);
      if (!m) return;
      const [, pre, num, post] = m;
      const target = parseFloat(num.replace(/,/g, ''));
      const decimals = (num.split('.')[1] || '').length;
      const grouped = num.indexOf(',') > -1;
      if (reduced || !isFinite(target)) return;
      const proxy = { v: 0 };
      ScrollTrigger.create({
        trigger: el,
        start: 'top 94%',
        once: true,
        onEnter: () =>
          gsap.to(proxy, {
            v: target,
            duration: 1.6,
            ease: 'power2.out',
            onUpdate: () => {
              const fixed = proxy.v.toFixed(decimals);
              el.textContent = pre + (grouped ? Number(fixed).toLocaleString('en-US') : fixed) + post;
            },
            onComplete: () => {
              el.textContent = raw;
            },
          }),
      });
    });

    /* A webfont swapping in after the triggers are measured leaves every pinned
       and batched start position wrong. Recalculate once the fonts land. */
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => ScrollTrigger.refresh());
    }
  }
</script>

<style is:global>
  .aur {
    --bg: #07070c;
    --bg-2: #0b0b13;
    --glass: rgba(255, 255, 255, 0.045);
    --glass-2: rgba(255, 255, 255, 0.075);
    --line: rgba(255, 255, 255, 0.09);
    --line-2: rgba(255, 255, 255, 0.16);
    --fg: #f4f4f7;
    --fg-2: #b3b4c2;
    --fg-3: #8b8c99;
    --vio: #a78bfa;
    --cya: #22d3ee;
    --pin: #f472b6;
    --grad: linear-gradient(135deg, #7c3aed 0%, #a855f7 45%, #c026d3 100%);
    --r: 22px;

    position: relative;
    isolation: isolate;
    background: var(--bg);
    color: var(--fg);
    font-family: 'Instrument Sans', system-ui, -apple-system, sans-serif;
    font-size: 16px;
    letter-spacing: -0.012em;
    overflow: clip;
  }

  /* ---------- ambient ---------- */
  .aur-mesh {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .aur-mesh__blob {
    position: absolute;
    display: block;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
    will-change: transform;
  }

  .aur-mesh__blob--a {
    width: 46vw;
    height: 46vw;
    top: -14vw;
    left: -8vw;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.85), transparent 66%);
  }

  .aur-mesh__blob--b {
    width: 40vw;
    height: 40vw;
    top: 6vw;
    right: -10vw;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.55), transparent 66%);
  }

  .aur-mesh__blob--c {
    width: 38vw;
    height: 38vw;
    top: 46vh;
    left: 34vw;
    background: radial-gradient(circle, rgba(236, 72, 153, 0.42), transparent 66%);
  }

  .aur-grid-lines {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.5;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 76px 76px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 20%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 20%, transparent 78%);
  }

  .aur-wrap {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: 24px;
    position: relative;
    z-index: 1;
  }

  .aur-glass {
    background: var(--glass);
    border: 1px solid var(--line);
    border-radius: var(--r);
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
  }

  /* ---------- nav ---------- */
  .aur-nav {
    position: sticky;
    top: 14px;
    z-index: 60;
    padding-inline: 24px;
    margin-bottom: -74px;
  }

  .aur-nav__pill {
    max-width: 1000px;
    margin-inline: auto;
    height: 60px;
    padding: 0 10px 0 18px;
    display: flex;
    align-items: center;
    gap: 28px;
    border-radius: 999px;
    background: rgba(11, 11, 19, 0.72);
    border: 1px solid var(--line);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
  }

  .aur-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.03em;
    flex: none;
  }

  .aur-brand__mark {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: var(--grad);
    font-size: 13px;
    font-weight: 700;
    color: #fff;
  }

  .aur-nav__links {
    display: flex;
    gap: 26px;
    margin-inline: auto;
    font-size: 14px;
  }

  .aur-nav__links a {
    color: var(--fg-2);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .aur-nav__links a:hover {
    color: var(--fg);
  }

  /* ---------- buttons ---------- */
  .aur-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    background: var(--grad);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 8px 30px rgba(124, 58, 237, 0.34);
    transition: box-shadow 0.25s ease, filter 0.25s ease;
    will-change: transform;
  }

  .aur-btn:hover {
    filter: brightness(1.08);
    box-shadow: 0 12px 40px rgba(124, 58, 237, 0.46);
  }

  .aur-btn--sm {
    height: 40px;
    padding: 0 18px;
    font-size: 14px;
    flex: none;
  }

  .aur-btn--ghost {
    background: var(--glass-2);
    border: 1px solid var(--line-2);
    color: var(--fg);
    box-shadow: none;
  }

  .aur-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    box-shadow: none;
  }

  .aur-btn--full {
    width: 100%;
  }

  /* ---------- hero ---------- */
  .aur-hero {
    padding: 168px 0 110px;
    text-align: center;
  }

  .aur-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--glass);
    border: 1px solid var(--line);
    font-size: 13px;
    color: var(--fg-2);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .aur-pill:hover {
    border-color: var(--line-2);
    color: var(--fg);
  }

  .aur-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cya);
    box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.18);
  }

  .aur-pill__go {
    color: var(--fg-3);
  }

  .aur-h1 {
    margin: 26px auto 0;
    max-width: 15ch;
    font-size: clamp(2.55rem, 6.1vw, 4.9rem);
    line-height: 0.99;
    font-weight: 500;
    letter-spacing: -0.048em;
  }

  .aur-h1--sm {
    font-size: clamp(2.1rem, 4.6vw, 3.5rem);
    max-width: 18ch;
  }

  .aur-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.09em;
    margin-bottom: -0.09em;
    margin-right: 0.24em;
  }

  .aur-word > span {
    display: inline-block;
  }

  html.js .aur-word > span {
    transform: translateY(108%);
  }

  .aur-word--acc {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  /* The gradient has to be clipped to the INNER span. Put it on the outer mask
     element and background-clip: text finds no glyphs of its own to clip to,
     so the whole line renders transparent and the headline loses a line. */
  .aur-word--acc > span {
    background: linear-gradient(100deg, #c4b5fd 0%, #67e8f9 52%, #f9a8d4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.06em;
  }

  .aur-sub {
    margin: 24px auto 0;
    max-width: 60ch;
    font-size: clamp(1rem, 1.35vw, 1.13rem);
    line-height: 1.62;
    color: var(--fg-2);
  }

  .aur-hero__cta {
    margin-top: 34px;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .aur-note {
    margin-top: 18px;
    font-size: 13px;
    color: var(--fg-3);
  }

  /* ---------- hero panel ---------- */
  .aur-panel {
    margin-top: 76px;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.028));
    border: 1px solid var(--line-2);
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.03) inset;
    text-align: left;
    will-change: transform;
  }

  .aur-panel__bar {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 44px;
    padding-inline: 16px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
  }

  .aur-panel__dots {
    display: flex;
    gap: 6px;
  }

  .aur-panel__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }

  .aur-panel__url {
    font-size: 12px;
    color: var(--fg-3);
  }

  .aur-panel__body {
    display: grid;
    grid-template-columns: 176px 1fr;
    min-height: 300px;
  }

  .aur-panel__side {
    border-right: 1px solid var(--line);
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .aur-panel__nav {
    padding: 9px 12px;
    border-radius: 9px;
    font-size: 13px;
    color: var(--fg-3);
  }

  .aur-panel__nav.is-on {
    background: rgba(255, 255, 255, 0.07);
    color: var(--fg);
  }

  .aur-panel__main {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .aur-panel__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .aur-panel__card {
    padding: 14px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .aur-panel__card em {
    font-style: normal;
    font-size: 12px;
    color: var(--fg-3);
  }

  .aur-panel__card strong {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .aur-panel__meter {
    display: block;
    height: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.09);
    overflow: hidden;
    margin-top: 4px;
  }

  .aur-panel__meter i {
    display: block;
    height: 100%;
    width: var(--pct);
    border-radius: 4px;
    background: var(--grad);
  }

  .aur-panel__chart {
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    min-height: 148px;
    padding: 16px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.026);
    border: 1px solid var(--line);
  }

  .aur-panel__bar {
    flex: 1;
    height: var(--h);
    border-radius: 5px 5px 2px 2px;
    background: linear-gradient(180deg, rgba(167, 139, 250, 0.9), rgba(34, 211, 238, 0.25));
  }

  /* ---------- marquee ---------- */
  .aur-marq {
    padding: 26px 0 70px;
    position: relative;
    z-index: 1;
  }

  .aur-marq__label {
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 26px;
  }

  .aur-marq__mask {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }

  .aur-marq__track {
    display: flex;
    gap: 68px;
    width: max-content;
    will-change: transform;
  }

  .aur-marq__item {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--fg-3);
    white-space: nowrap;
  }

  /* ---------- sections ---------- */
  .aur-sec {
    padding: 90px 0;
    position: relative;
    z-index: 1;
  }

  .aur-head {
    max-width: 62ch;
    margin-bottom: 52px;
  }

  .aur-eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vio);
    margin-bottom: 14px;
  }

  .aur-h2 {
    font-size: clamp(1.85rem, 3.5vw, 2.9rem);
    line-height: 1.06;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .aur-lead {
    margin-top: 16px;
    font-size: 1.03rem;
    line-height: 1.65;
    color: var(--fg-2);
  }

  .aur-three {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .aur-prob {
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .aur-prob__n {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-size: 30px;
    line-height: 1;
    color: var(--vio);
    margin-bottom: 4px;
  }

  .aur-prob h3 {
    font-size: 1.06rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .aur-prob p {
    font-size: 0.925rem;
    line-height: 1.62;
    color: var(--fg-2);
  }

  /* ---------- BENTO. The layout engine of this skin ---------- */
  .aur-bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(196px, auto);
    gap: 18px;
  }

  .aur-tile {
    position: relative;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .aur-tile:hover {
    border-color: var(--line-2);
    background: var(--glass-2);
  }

  .aur-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(420px 220px at 80% 0%, rgba(167, 139, 250, 0.14), transparent 70%);
  }

  .aur-tile--1 {
    grid-column: span 2;
    grid-row: span 2;
  }

  .aur-tile--2 {
    grid-column: span 2;
  }

  .aur-tile--5,
  .aur-tile--6 {
    grid-column: span 2;
  }

  .aur-tile__glyph {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-size: 26px;
    line-height: 1;
    color: var(--cya);
  }

  .aur-tile__t {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .aur-tile__b {
    font-size: 0.925rem;
    line-height: 1.62;
    color: var(--fg-2);
    max-width: 46ch;
  }

  .aur-tile__vis {
    margin-top: auto;
    padding-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    z-index: 1;
  }

  .aur-tile__row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line);
    font-size: 13px;
  }

  .aur-tile__av {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: var(--grad);
    font-size: 11px;
    font-weight: 700;
    font-style: normal;
    color: #fff;
    flex: none;
  }

  .aur-tile__row em {
    font-style: normal;
    color: var(--fg-2);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .aur-tile__tag {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--fg-3);
    flex: none;
  }

  .aur-tile__tag.is-live {
    background: rgba(34, 211, 238, 0.14);
    color: #67e8f9;
  }

  .aur-tile__ring {
    margin-top: auto;
    padding-top: 18px;
    display: flex;
    align-items: center;
    gap: 16px;
    position: relative;
    z-index: 1;
  }

  .aur-tile__ring span {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  /* ---------- showcase ---------- */
  .aur-split {
    display: grid;
    grid-template-columns: 1fr 0.86fr;
    gap: 64px;
    align-items: center;
  }

  .aur-checks {
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .aur-checks li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--fg-2);
  }

  .aur-checks svg {
    flex: none;
    margin-top: 3px;
    color: var(--cya);
  }

  .aur-orbit {
    position: relative;
    width: min(100%, 380px);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .aur-orbit__core {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 76px;
    height: 76px;
    display: grid;
    place-items: center;
    border-radius: 24px;
    background: var(--grad);
    font-size: 28px;
    font-weight: 700;
    color: #fff;
    box-shadow: 0 16px 50px rgba(124, 58, 237, 0.5);
    z-index: 2;
  }

  .aur-orbit__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    border: 1px dashed var(--line-2);
    transform: translate(-50%, -50%);
    will-change: transform;
  }

  .aur-orbit__ring--1 {
    width: 62%;
    height: 62%;
  }

  .aur-orbit__ring--2 {
    width: 100%;
    height: 100%;
    border-style: solid;
    border-color: var(--line);
  }

  .aur-orbit__node {
    position: absolute;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(11, 11, 19, 0.9);
    border: 1px solid var(--line-2);
    font-size: 12.5px;
    color: var(--fg-2);
    white-space: nowrap;
    transform: translate(-50%, -50%);
    z-index: 3;
  }

  .aur-orbit__node--1 {
    left: 50%;
    top: 0;
  }

  .aur-orbit__node--2 {
    left: 100%;
    top: 50%;
  }

  .aur-orbit__node--3 {
    left: 50%;
    top: 100%;
  }

  .aur-orbit__node--4 {
    left: 0;
    top: 50%;
  }

  /* ---------- stats ---------- */
  .aur-stats {
    padding: 34px 0 70px;
    position: relative;
    z-index: 1;
  }

  .aur-stats__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .aur-stat {
    padding: 26px 22px;
    border-radius: var(--r);
    background: var(--glass);
    border: 1px solid var(--line);
    text-align: center;
  }

  .aur-stat strong {
    display: block;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    background: linear-gradient(120deg, #ddd6fe, #67e8f9);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }

  .aur-stat span {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    color: var(--fg-3);
  }

  /* ---------- proof ---------- */
  .aur-quote {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
  }

  .aur-quote__mark {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 60px;
    line-height: 0.5;
    color: var(--vio);
    opacity: 0.5;
  }

  .aur-quote blockquote {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg);
    flex: 1;
  }

  .aur-quote figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .aur-quote__av {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--glass-2);
    border: 1px solid var(--line-2);
    font-weight: 600;
    flex: none;
  }

  .aur-quote figcaption strong {
    display: block;
    font-size: 14px;
    font-weight: 600;
  }

  .aur-quote figcaption em {
    display: block;
    font-style: normal;
    font-size: 12.5px;
    color: var(--fg-3);
    margin-top: 2px;
  }

  /* ---------- pricing ---------- */
  .aur-plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    align-items: start;
  }

  .aur-plan {
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
  }

  .aur-plan.is-feat {
    border-color: transparent;
    background:
      linear-gradient(var(--bg-2), var(--bg-2)) padding-box,
      var(--grad) border-box;
    border: 1px solid transparent;
    box-shadow: 0 24px 70px rgba(124, 58, 237, 0.24);
  }

  .aur-plan__tag {
    position: absolute;
    top: -11px;
    left: 26px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--grad);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
  }

  .aur-plan__n {
    font-size: 1.06rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .aur-plan__blurb {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--fg-3);
    min-height: 2.9em;
  }

  .aur-plan__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-bottom: 6px;
  }

  .aur-plan__price strong {
    font-size: 2.4rem;
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  .aur-plan__price em {
    font-style: normal;
    font-size: 13px;
    color: var(--fg-3);
  }

  .aur-plan__feat {
    display: flex;
    flex-direction: column;
    gap: 11px;
    padding-top: 6px;
  }

  .aur-plan__feat li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--fg-2);
  }

  .aur-plan__feat svg {
    flex: none;
    margin-top: 3px;
    color: var(--vio);
  }

  .aur-guar {
    margin-top: 22px;
    padding: 34px;
    text-align: center;
  }

  .aur-guar h3 {
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    margin-bottom: 12px;
  }

  .aur-guar p {
    max-width: 68ch;
    margin-inline: auto;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--fg-2);
  }

  /* ---------- faq ---------- */
  .aur-faq {
    display: grid;
    grid-template-columns: 0.72fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .aur-faq__list {
    display: flex;
    flex-direction: column;
  }

  .aur-faq__item {
    border-top: 1px solid var(--line);
  }

  .aur-faq__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .aur-faq__item summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 40px 22px 0;
    position: relative;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .aur-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .aur-faq__ico {
    position: absolute;
    right: 4px;
    top: 50%;
    width: 13px;
    height: 13px;
    transform: translateY(-50%);
  }

  .aur-faq__ico::before,
  .aur-faq__ico::after {
    content: '';
    position: absolute;
    background: var(--fg-3);
    border-radius: 2px;
