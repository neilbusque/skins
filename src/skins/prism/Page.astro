---
/**
 * SKIN: Prism  ·  archetype: Stacking Cards  ·  motion: GSAP + ScrollTrigger
 *
 * Launch page energy. Deep plum base, a four stop prism gradient used as one
 * continuous light source, Space Grotesk display over Figtree body.
 *
 * Layout engine: STICKY CARD STACK. Every feature is a full card that sticks,
 * then shrinks and dims as the next card slides over it. The stack itself is
 * plain CSS position: sticky. GSAP only scrubs the scale and the dimming, so
 * there is no pin, no spacer, and the stack still reads with JS off.
 */
import { content as c } from '../../lib/content';

const year = 2026;
const headWords = c.hero.headline.split(' ');
const accentWords = c.hero.headlineAccent.split(' ');
---

<div class="prz">
  <span class="prz-progress" aria-hidden="true"><i data-progress></i></span>
  <div class="prz-glow" aria-hidden="true"></div>

  <header class="prz-nav">
    <div class="prz-wrap prz-nav__in">
      <a class="prz-brand" href="#">
        <span class="prz-brand__mark">{c.brand.mark}</span>
        <span>{c.brand.name}</span>
      </a>
      <nav class="prz-nav__links" aria-label="Primary">
        {c.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <a class="prz-btn prz-btn--sm" href={c.nav.cta.href}>{c.nav.cta.label}</a>
    </div>
  </header>

  <section class="prz-hero">
    <div class="prz-wrap prz-hero__in">
      <a class="prz-pill" href="#" data-anim>
        <span class="prz-pill__dot"></span>
        {c.hero.eyebrow}
      </a>

      <h1 class="prz-h1" aria-label={`${c.hero.headline} ${c.hero.headlineAccent}`}>
        {
          headWords.map((w) => (
            <span class="prz-word" data-anim>
              <span>{w}</span>
            </span>
          ))
        }
        <br />
        {
          accentWords.map((w) => (
            <span class="prz-word prz-word--acc" data-anim>
              <span>{w}</span>
            </span>
          ))
        }
      </h1>

      <p class="prz-sub" data-anim>{c.hero.sub}</p>

      <div class="prz-hero__cta" data-anim>
        <a class="prz-btn prz-btn--lg" href={c.hero.ctaPrimary.href}>{c.hero.ctaPrimary.label}</a>
        <a class="prz-btn prz-btn--ghost prz-btn--lg" href={c.hero.ctaSecondary.href}>
          {c.hero.ctaSecondary.label}
        </a>
      </div>

      <p class="prz-note" data-anim>{c.hero.note}</p>

      <div class="prz-logos" data-anim>
        <p>{c.logos.label}</p>
        <div>{c.logos.items.map((n) => <span>{n}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="prz-sec">
    <div class="prz-wrap">
      <div class="prz-head">
        <p class="prz-eyebrow" data-anim>{c.problem.eyebrow}</p>
        <h2 class="prz-h2" data-anim>{c.problem.headline}</h2>
        <p class="prz-lead" data-anim>{c.problem.body}</p>
      </div>
      <div class="prz-three">
        {
          c.problem.points.map((p, i) => (
            <article class="prz-mini" data-anim>
              <span class="prz-mini__n" style={`--n:${i}`}>{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- THE STACK. Sticky in CSS, scrubbed by GSAP. -->
  <section class="prz-stackSec" id="features">
    <div class="prz-wrap">
      <div class="prz-head prz-head--center">
        <p class="prz-eyebrow" data-anim>{c.features.eyebrow}</p>
        <h2 class="prz-h2" data-anim>{c.features.headline}</h2>
        <p class="prz-lead" data-anim>{c.features.sub}</p>
      </div>

      <div class="prz-stack" data-stack>
        {
          c.features.items.map((f, i) => (
            <div class="prz-stack__slot" style={`--i:${i}`}>
              <article class={`prz-card prz-card--${(i % 4) + 1}`} data-card data-anim>
                <div class="prz-card__l">
                  <span class="prz-card__n">{f.glyph}</span>
                  <h3 class="prz-card__t">{f.title}</h3>
                  <p class="prz-card__b">{f.body}</p>
                </div>
                <div class="prz-card__r" aria-hidden="true">
                  <span class="prz-card__orb"></span>
                  <span class="prz-card__ring"></span>
                  <span class="prz-card__tick">{f.glyph}</span>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="prz-sec" id="showcase">
    <div class="prz-wrap prz-split">
      <div class="prz-split__copy">
        <p class="prz-eyebrow" data-anim>{c.showcase.eyebrow}</p>
        <h2 class="prz-h2" data-anim>{c.showcase.headline}</h2>
        <p class="prz-lead" data-anim>{c.showcase.body}</p>
        <ul class="prz-checks">
          {
            c.showcase.bullets.map((b) => (
              <li data-anim>
                <em></em>
                {b}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="prz-split__vis" data-anim>
        <div class="prz-rail">
          {
            [
              ['Google Workspace', 'Calendar, Drive, Gmail'],
              ['Slack', 'Threads and approvals'],
              ['Stripe', 'Invoices and payouts'],
            ].map(([t, s], i) => (
              <span class="prz-rail__node" style={`--n:${i}`}>
                <i></i>
                <span>
                  <strong>{t}</strong>
                  <em>{s}</em>
                </span>
              </span>
            ))
          }
          <span class="prz-rail__hub">
            <strong>{c.brand.name}</strong>
            <em>One source of truth</em>
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="prz-stats">
    <div class="prz-wrap prz-stats__row">
      {
        c.stats.map((s) => (
          <div class="prz-stat" data-anim>
            <strong data-count={s.value}>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="prz-sec" id="proof">
    <div class="prz-wrap">
      <div class="prz-head prz-head--center">
        <p class="prz-eyebrow" data-anim>{c.proof.eyebrow}</p>
        <h2 class="prz-h2" data-anim>{c.proof.headline}</h2>
      </div>
      <div class="prz-three">
        {
          c.testimonials.map((t) => (
            <figure class="prz-quote" data-anim>
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="prz-quote__av">{t.name.charAt(0)}</span>
                <span>
                  <strong>{t.name}</strong>
                  <em>{t.role}, {t.company}</em>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="prz-sec" id="pricing">
    <div class="prz-wrap">
      <div class="prz-head prz-head--center">
        <p class="prz-eyebrow" data-anim>{c.pricing.eyebrow}</p>
        <h2 class="prz-h2" data-anim>{c.pricing.headline}</h2>
        <p class="prz-lead" data-anim>{c.pricing.sub}</p>
      </div>
      <div class="prz-plans">
        {
          c.pricing.plans.map((p) => (
            <article class:list={['prz-plan', { 'is-feat': p.featured }]} data-anim>
              {p.featured && <span class="prz-plan__tag">Most teams</span>}
              <h3>{p.name}</h3>
              <p class="prz-plan__blurb">{p.blurb}</p>
              <p class="prz-plan__price">
                <strong>{p.price}</strong>
                <em>{p.period}</em>
              </p>
              <a class:list={['prz-btn', 'prz-btn--full', { 'prz-btn--ghost': !p.featured }]} href="#cta">
                {p.cta}
              </a>
              <ul>
                {p.features.map((f) => (
                  <li>
                    <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path d="m2.8 7.2 2.8 2.8 5.6-6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <div class="prz-guar" data-anim>
        <h3>{c.guarantee.headline}</h3>
        <p>{c.guarantee.body}</p>
      </div>
    </div>
  </section>

  <section class="prz-sec">
    <div class="prz-wrap prz-faq">
      <div class="prz-faq__head">
        <p class="prz-eyebrow" data-anim>{c.faqHead.eyebrow}</p>
        <h2 class="prz-h2" data-anim>{c.faqHead.headline}</h2>
      </div>
      <div class="prz-faq__list" data-anim>
        {
          c.faq.map((f, i) => (
            <details class="prz-faq__item" open={i === 0}>
              <summary>
                {f.q}
                <span class="prz-faq__ico" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="prz-cta" id="cta">
    <div class="prz-cta__glow" aria-hidden="true"></div>
    <div class="prz-wrap prz-cta__in">
      <h2 class="prz-h1 prz-h1--sm" data-anim>{c.cta.headline}</h2>
      <p class="prz-sub" data-anim>{c.cta.sub}</p>
      <div class="prz-hero__cta" data-anim>
        <a class="prz-btn prz-btn--lg" href={c.cta.button.href}>{c.cta.button.label}</a>
      </div>
      <p class="prz-note" data-anim>{c.cta.note}</p>
    </div>
  </section>

  <footer class="prz-foot">
    <div class="prz-wrap prz-foot__in">
      <div class="prz-foot__brand">
        <a class="prz-brand" href="#">
          <span class="prz-brand__mark">{c.brand.mark}</span>
          <span>{c.brand.name}</span>
        </a>
        <p>{c.brand.tagline}</p>
      </div>
      {
        c.footer.columns.map((col) => (
          <div class="prz-foot__col">
            <h4>{col.title}</h4>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="prz-wrap prz-foot__legal">
      <span>&copy; {year} {c.brand.name}</span>
      <span>{c.footer.legal}</span>
    </div>
  </footer>
</div>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector('.prz');
  if (root) {
    const q = (sel) => Array.from(root.querySelectorAll(sel));
    const anims = q('[data-anim]');
    const words = q('.prz-word > span');
    const cards = q('[data-card]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced) {
      gsap.set(anims, { opacity: 1, y: 0 });
      gsap.set(words, { y: 0 });
    } else {
      const heroAnims = q('.prz-hero [data-anim]');
      const skip = new Set([...heroAnims, ...cards]);

      gsap
        .timeline({ defaults: { ease: 'power3.out' } })
        .fromTo('.prz-pill', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 })
        .to('.prz-word', { opacity: 1, duration: 0.01, stagger: 0.04 }, 0.12)
        .to('.prz-word > span', { y: '0%', duration: 1.05, stagger: 0.04, ease: 'expo.out' }, 0.12)
        .fromTo('.prz-hero .prz-sub', { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: 0.75 }, 0.5)
        .fromTo('.prz-hero .prz-hero__cta', { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: 0.75 }, 0.58)
        .fromTo('.prz-hero .prz-note', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.7 }, 0.66)
        .fromTo('.prz-logos', { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: 0.8 }, 0.74);

      ScrollTrigger.batch(
        anims.filter((el) => !skip.has(el)),
        {
          start: 'top 90%',
          once: true,
          batchMax: 4,
          onEnter: (batch) =>
            gsap.fromTo(
              batch,
              { opacity: 0, y: 30 },
              { opacity: 1, y: 0, duration: 0.65, stagger: 0.05, ease: 'power3.out', overwrite: 'auto' }
            ),
        }
      );

      /* Cards get an opacity only reveal. They also carry a scrubbed scale
         further down, and mixing a y tween with that scrub on one element is a
         fight over the same transform. */
      cards.forEach((card) => {
        ScrollTrigger.create({
          trigger: card,
          start: 'top 92%',
          once: true,
          onEnter: () => gsap.to(card, { opacity: 1, duration: 0.6, ease: 'power2.out' }),
        });
      });

      /* ---- THE STACK. Card i shrinks and dims across the arrival of card i+1.
             Scale and filter only. A scrubbed opacity would leave a card
             invisible any time the page sits scrolled back above it ---- */
      cards.forEach((card, i) => {
        const next = cards[i + 1];
        if (!next) return;
        gsap.fromTo(
          card,
          { scale: 1, filter: 'brightness(1)' },
          {
            scale: 0.9,
            filter: 'brightness(0.62)',
            ease: 'none',
            scrollTrigger: {
              trigger: next,
              start: 'top 86%',
              end: 'top 22%',
              scrub: 0.5,
            },
          }
        );
      });

      /* ---- page scroll progress ---- */
      const bar = root.querySelector('[data-progress]');
      if (bar) {
        gsap.to(bar, {
          scaleX: 1,
          ease: 'none',
          scrollTrigger: { trigger: root, start: 'top top', end: 'bottom bottom', scrub: 0.3 },
        });
      }

      /* ---- gradient drift on the headline and the ambient glow ---- */
      gsap.to('.prz-word--acc > span', {
        backgroundPositionX: '220%',
        duration: 9,
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true,
      });
      gsap.to('.prz-glow', {
        xPercent: 8,
        yPercent: -6,
        scale: 1.14,
        duration: 17,
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true,
      });
    }

    /* ---- counting stats ---- */
    q('[data-count]').forEach((el) => {
      const raw = el.getAttribute('data-count') || '';
      const m = raw.match(/^(\D*)([\d.,]+)(.*)$/);
      if (!m || reduced) return;
      const [, pre, num, post] = m;
      const target = parseFloat(num.replace(/,/g, ''));
      if (!isFinite(target)) return;
      const decimals = (num.split('.')[1] || '').length;
      const grouped = num.indexOf(',') > -1;
      const proxy = { v: 0 };
      ScrollTrigger.create({
        trigger: el,
        start: 'top 94%',
        once: true,
        onEnter: () =>
          gsap.to(proxy, {
            v: target,
            duration: 1.5,
            ease: 'power2.out',
            onUpdate: () => {
              const fixed = proxy.v.toFixed(decimals);
              el.textContent = pre + (grouped ? Number(fixed).toLocaleString('en-US') : fixed) + post;
            },
            onComplete: () => {
              el.textContent = raw;
            },
          }),
      });
    });

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => ScrollTrigger.refresh());
    }
  }
</script>

<style is:global>
  .prz {
    --bg: #0b0616;
    --bg-2: #150c26;
    --surf: rgba(255, 255, 255, 0.045);
    --surf-2: rgba(255, 255, 255, 0.08);
    --line: rgba(255, 255, 255, 0.1);
    --line-2: rgba(255, 255, 255, 0.19);
    --fg: #f6f3ff;
    --fg-2: #bcb2d6;
    --fg-3: #9086ab;
    --p1: #ff7a45;
    --p2: #f43f8e;
    --p3: #8b5cf6;
    --p4: #38bdf8;
    --grad: linear-gradient(115deg, var(--p1) 0%, var(--p2) 36%, var(--p3) 70%, var(--p4) 100%);
    --r: 26px;

    position: relative;
    isolation: isolate;
    background: var(--bg);
    color: var(--fg);
    font-family: 'Figtree', system-ui, -apple-system, sans-serif;
    font-size: 16px;
    letter-spacing: -0.012em;
    overflow: clip;
  }

  .prz-progress {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    height: 3px;
    z-index: 90;
    background: rgba(255, 255, 255, 0.06);
  }

  .prz-progress i {
    display: block;
    height: 100%;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .prz-glow {
    position: fixed;
    left: 50%;
    top: -22vh;
    width: 92vw;
    max-width: 1200px;
    height: 78vh;
    transform: translateX(-50%);
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 42% 58% at 22% 42%, rgba(255, 122, 69, 0.4), transparent 70%),
      radial-gradient(ellipse 40% 56% at 52% 30%, rgba(244, 63, 142, 0.42), transparent 70%),
      radial-gradient(ellipse 44% 60% at 78% 48%, rgba(139, 92, 246, 0.44), transparent 70%);
    filter: blur(76px);
    opacity: 0.75;
    will-change: transform;
  }

  .prz-wrap {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: 24px;
    position: relative;
    z-index: 1;
  }

  /* ---------- nav ---------- */
  .prz-nav {
    position: sticky;
    top: 0;
    z-index: 60;
    border-bottom: 1px solid var(--line);
    background: rgba(11, 6, 22, 0.76);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .prz-nav__in {
    display: flex;
    align-items: center;
    gap: 34px;
    height: 66px;
  }

  .prz-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.045em;
    flex: none;
  }

  .prz-brand__mark {
    width: 27px;
    height: 27px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: var(--grad);
    color: #14071f;
    font-size: 13px;
    font-weight: 700;
  }

  .prz-nav__links {
    display: flex;
    gap: 28px;
    margin-inline: auto;
    font-size: 14.5px;
  }

  .prz-nav__links a {
    color: var(--fg-2);
    text-decoration: none;
  }

  .prz-nav__links a:hover {
    color: var(--fg);
  }

  /* ---------- buttons ---------- */
  .prz-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 25px;
    border-radius: 999px;
    background: var(--grad);
    background-size: 180% 100%;
    color: #16081f;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-position 0.5s ease, transform 0.22s ease, box-shadow 0.22s ease;
    box-shadow: 0 10px 34px rgba(244, 63, 142, 0.3);
  }

  .prz-btn:hover {
    background-position: 100% 0;
    transform: translateY(-2px);
    box-shadow: 0 16px 44px rgba(244, 63, 142, 0.42);
  }

  .prz-btn--sm {
    height: 40px;
    padding: 0 18px;
    font-size: 14px;
    flex: none;
  }

  .prz-btn--lg {
    height: 56px;
    padding: 0 30px;
    font-size: 16px;
  }

  .prz-btn--ghost {
    background: var(--surf-2);
    color: var(--fg);
    border: 1px solid var(--line-2);
    box-shadow: none;
  }

  .prz-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.13);
    box-shadow: none;
  }

  .prz-btn--full {
    width: 100%;
  }

  /* ---------- hero ---------- */
  .prz-hero {
    padding: 100px 0 86px;
    text-align: center;
  }

  .prz-hero__in {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .prz-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 34px;
    padding: 0 15px;
    border-radius: 999px;
    background: var(--surf);
    border: 1px solid var(--line);
    font-size: 13px;
    color: var(--fg-2);
    text-decoration: none;
  }

  .prz-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--p1);
    box-shadow: 0 0 10px var(--p1);
  }

  .prz-h1 {
    margin-top: 26px;
    max-width: 16ch;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(2.6rem, 6.4vw, 5.1rem);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.055em;
  }

  .prz-h1--sm {
    font-size: clamp(2.1rem, 4.8vw, 3.6rem);
    max-width: 18ch;
  }

  .prz-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
    margin-right: 0.22em;
  }

  .prz-word > span {
    display: inline-block;
  }

  html.js .prz-word > span {
    transform: translateY(110%);
  }

  .prz-word--acc > span {
    background: var(--grad);
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.06em;
  }

  .prz-sub {
    margin-top: 24px;
    max-width: 58ch;
    font-size: clamp(1rem, 1.35vw, 1.13rem);
    line-height: 1.62;
    color: var(--fg-2);
  }

  .prz-hero__cta {
    margin-top: 34px;
    display: flex;
    justify-content: center;
